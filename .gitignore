# Local .terraform directories
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude sensitive variables files
*.tfvars
*.tfvars.json
!example.tfvars
!*.tfvars.example

# Ignore CLI configuration files
.terraformrc
terraform.rc

# OS and IDE files
.DS_Store
Thumbs.db
.vscode/
.idea/
